# --- Server -----------------------------------------------------------------
ENVIRONMENT=development            # production refuses DEMO_MODE
DATABASE_URL=sqlite+aiosqlite:///./timnhac.db
REDIS_URL=                         # empty = in-memory cache (dev only)
LOG_LEVEL=INFO
ADMIN_TOKEN=                       # enables /admin/reports (link moderation)

# --- Recognition engines (section 5) ----------------------------------------
# ACRCloud project with "3rd Party ID Integration" enabled.
ACRCLOUD_HOST=identify-ap-southeast-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
# Optional separate "Cover Song (humming)" project; empty = reuse the project above.
ACRCLOUD_HUM_HOST=
ACRCLOUD_HUM_ACCESS_KEY=
ACRCLOUD_HUM_ACCESS_SECRET=
AUDD_API_TOKEN=
# Canned results to try the app without any engine key. Never in production.
DEMO_MODE=false

# --- Abuse protection ---------------------------------------------------------
INTEGRITY_MODE=off                 # off | monitor | enforce
PLAY_PACKAGE_NAME=vn.timnhac.app
PLAY_CLOUD_PROJECT_NUMBER=         # Google Cloud project number linked in Play Console
GOOGLE_SERVICE_ACCOUNT_FILE=       # service account JSON with Play Integrity access
QUOTA_PER_DEVICE_PER_DAY=30
MIN_APP_VERSION=1.0.0

# --- Link resolver (section 6) ------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_DAILY_LIMIT=100
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
JAMENDO_CLIENT_ID=
ODESLI_ENABLED=true
BRAVE_SEARCH_API_KEY=              # whitelisted web search (F9); empty = off
MATCH_SCORE_THRESHOLD=0.72
DURATION_TOLERANCE_S=3
# Deep search templates can be fixed without an app release, e.g.
# SEARCH_URL_OVERRIDES={"zing_mp3": "https://zingmp3.vn/tim-kiem/tat-ca?q={q}"}
